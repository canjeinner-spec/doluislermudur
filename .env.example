# Copy this file to `.env` and fill in from your Supabase project
# (Project Settings → API). These are safe to ship in the app bundle — the anon
# key is public and protected by Row Level Security. See docs/BACKEND.md.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
